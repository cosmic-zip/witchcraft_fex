# WitchcraftFEX Environment Configuration
# Copy this file to .env and modify as needed

# Debug mode - enable verbose logging
# Values: true, 1, yes, on | false, 0, no, off
; NT_DEBUG=True

# Clear the terminal before a new command
; NT_CLEAR_TERM=True

# Version string
NT_VERSION=WitchcraftFEX v0.1.0 by COSMIC ZIP 01-OCT-2025

# Data root directory for spells, models, and packages
NT_DATAROOT=spellbook/

# Terminal output mode
# Options: none, color, html
NT_SETUP_COLORS=color

# Enable file logging
# Values: True, False
NT_ENABLE_LOGGER=False

# Enable arbitrary shell command execution
# Values: True, False
NT_ENABLE_ARBITRARY_SHELL=True

# Session identifier
NT_SESSION=default

# Cosmic signature key for authentication
NT_COSMIC_SIGKEY=b7a5f1f46944d5cc438646c547e20b177257608b5dfff41d7c5f063a6ea092fe

# Generator host URL
NT_GEN_HOST=http://localhost:5500

# Generator title/name
NT_GEN_TITLE=⛩️ NettravalerEX

# Headless browser binary
# Options: chromium, google-chrome, /path/to/custom/browser
NT_HEADLESS_BROWSER_BIN=chromium

# Observer
# --- Portainer ---
PORTAINER_ADMIN_USER=admin
PORTAINER_ADMIN_PASSWORD=admin
PORTAINER_ADMIN_PASSWORD_HASH=admin
PORTAINER_PORT=9443
PORTAINER_HTTP_PORT=8000
PORTAINER_DATA_VOLUME=portainer_data
PORTAINER_IMAGE=portainer/portainer-ce:latest

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
GRAFANA_PROTOCOL=http
GRAFANA_DOMAIN=localhost
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_DATABASE_TYPE=sqlite3