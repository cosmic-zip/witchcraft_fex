FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \python3 \python3-pip \sudo \&& rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN chmod +x spellbook/pkg/config/install.sh
RUN ./spellbook/pkg/config/install.sh
CMD ["python3", "main.py", "server", "--host", "0.0.0.0", "--port", "5500", "--folder", "spellbook/webui", "--model", "none"]