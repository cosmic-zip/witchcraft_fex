# Demonstração completa da linguagem Witchcraft-Xcript (baseada em scr/define.config)

# 1. Declarações com Omega Type ("", [], table[x,y])
declare banner = "=== Witchcraft-Xcript Static Runtime ==="
declare targets = ["10.0.0.1", "10.0.0.2", "10.0.0.3"]
declare config = table["profile", "cypherpunk"]

echo banner
echo config["profile"]

# 2. Laço while x until y
declare counter = 0
while true until counter == 3 {
    echo "while counter: " + counter
    counter = counter + 1
}

# 3. Laços for (in, ++1, --1)
for host in targets {
    echo "scanning host: " + host
}

declare step_up = 0
for step_up in step_up++1 until step_up == 3 {
    echo "step_up: " + step_up
}

declare step_down = 3
for step_down in step_down--1 until step_down == 0 {
    echo "step_down: " + step_down
}

# 4. Análise de padrões (pattern analises)
declare X = "bloodmoon-cyberdeck-v1"
declare res;
res = analyse X condition "cyberdeck"

# 5. Condicionais (if / elif / else / default)
if res {
    echo "Pattern matched on X!"
} elif counter == 99 {
    echo "Unreachable branch"
} else {
    echo "Else branch"
} default {
    echo "Default fallback branch"
}

# 6. Execução de comandos e warn (stdout + stderr)
declare cmd_res = table[];
cmd_res = exec "echo 'Xcript command execution OK'"
warn cmd_res
warn["[OK] Xcript finished", "[WARN] Diagnostic channel active"]

